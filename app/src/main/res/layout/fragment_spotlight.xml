<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movie Spotlight"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="20dp"/>

        <ImageView
            android:id="@+id/spotlightImage"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:src="@drawable/interstellar"
            android:scaleType="fitCenter"
            android:contentDescription="Interstellar movie image"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Interstellar (2014)"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/spotlightDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Interstellar is a science fiction film directed by Christopher Nolan. It follows a group of astronauts traveling through a wormhole in search of a new home for humanity. The movie explores space exploration, time, survival, and the powerful bond between a father and his daughter."
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
